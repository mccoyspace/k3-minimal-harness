#!/usr/bin/env bash
set -euo pipefail

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
pid_path=$project_dir/.k3/job-ui.pid
log_path=$project_dir/.k3/job-ui.log
port=${K3_JOB_UI_PORT:-8042}
url=http://127.0.0.1:$port

mkdir -p "$project_dir/.k3"
if [[ -f $pid_path ]]; then
    pid=$(tr -d '[:space:]' <"$pid_path")
    if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
        if [[ $cmdline == *k3_job_ui.py* ]]; then
            echo "K3 Studio Jobs already running at $url (PID $pid)"
            exit 0
        fi
        echo "refusing to replace unrecognized PID $pid" >&2
        exit 2
    fi
fi

if command -v setsid >/dev/null 2>&1; then
    setsid -f "$project_dir/bin/k3-job-ui" --port "$port" \
        </dev/null >"$log_path" 2>&1
else
    nohup "$project_dir/bin/k3-job-ui" --port "$port" \
        </dev/null >"$log_path" 2>&1 &
fi
for _ in $(seq 1 30); do
    if curl --fail --silent --max-time 2 "$url/" >/dev/null 2>&1; then
        pid=$(tr -d '[:space:]' <"$pid_path")
        echo "K3 Studio Jobs ready at $url (PID $pid)"
        exit 0
    fi
    sleep 1
done

echo "K3 Studio Jobs did not become ready" >&2
tail -40 "$log_path" >&2
exit 1
