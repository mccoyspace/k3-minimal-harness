#!/usr/bin/env bash
set -euo pipefail

profile=${1:-k3}
base_url=${WASTE_BASE_URL:-http://127.0.0.1:8000}

case "$profile" in
    k3)
        status_path=${K3_QOS_STATUS:-${WASTE_QOS_STATUS:-/var/lib/waste-qos/k3-minimal-fast-status.json}}
        expected_model=${WASTE_K3_MODEL_ID:-k3}
        expected_threads=10
        expected_dense=2
        expected_learning=true
        expected_prefix=true
        expected_affinity=${WASTE_K3_CPU_LIST:-${WASTE_CPU_LIST:-5-9,15-19}}
        ;;
    k2)
        status_path=${K2_QOS_STATUS:-${WASTE_QOS_STATUS:-/var/lib/waste-qos/k2-fast-status.json}}
        expected_model=${WASTE_K2_MODEL_ID:-kimi-k2}
        expected_threads=8
        expected_dense=3
        expected_learning=false
        expected_prefix=false
        expected_affinity=${WASTE_K2_CPU_LIST:-${WASTE_CPU_LIST:-5-9,15-19}}
        ;;
    *)
        echo "usage: $(basename -- "$0") [k3|k2]" >&2
        exit 2
        ;;
esac

echo "Health:"
health=$(curl --fail --silent --show-error --max-time 5 "$base_url/health")
printf '%s\n' "$health"
echo
echo "Models:"
curl --fail --silent --show-error --max-time 5 "$base_url/v1/models"
echo

python3 -c '
import json, sys
profile, expected_model, expected_threads, expected_learning, expected_prefix, expected_affinity, raw = sys.argv[1:]
h = json.loads(raw)
p = h["performance_profile"]
e = p["engine"]
s = p["storage"]
l = h.get("usage_learning", {})
checks = {
    "model=" + expected_model: h.get("model") == expected_model,
    "threads=" + expected_threads: e.get("threads") == int(expected_threads),
    "cache=lfru": e.get("cache") == "lfru",
    "direct_io": e.get("direct_io_effective") is True,
    "readers=2": s.get("effective_read_ahead_threads") == 2,
    "depth=2": s.get("effective_read_ahead_depth") == 2,
    "lookahead=6": s.get("requested_router_lookahead") == 6,
    "usage_learning=" + expected_learning:
        l.get("enabled") == (expected_learning == "true"),
    "prefix_cache=" + expected_prefix:
        h.get("prefix_cache", {}).get("enabled") == (expected_prefix == "true"),
}
if profile == "k2":
    affinity = p.get("cpu_affinity", {})
    checks["compute_only_affinity=" + expected_affinity] = (
        affinity.get("managed") is True and
        affinity.get("scope") == "compute_only" and
        affinity.get("effective_cpu_list") == expected_affinity)
failed = [name for name, ok in checks.items() if not ok]
if failed:
    raise SystemExit("WARP capability check failed: " + ", ".join(failed))
print("Engine capability check: PASS (" + ", ".join(checks) + ")")
' "$profile" "$expected_model" "$expected_threads" \
  "$expected_learning" "$expected_prefix" "$expected_affinity" "$health"

qos=$(sudo -n cat "$status_path")
child_pid=$(python3 -c '
import json, sys
q = json.loads(sys.argv[1])
if not (q.get("fd_active") and q.get("latency_us") == 0 and
        q.get("scope") == "child"):
    raise SystemExit("WARP capability check failed: Q0 is not active")
print(q["child_pid"])
' "$qos"
)

live_environment=$(sudo -n tr '\0' '\n' <"/proc/$child_pid/environ")
expected_environment=(
    WASTE_Q8=1
    WASTE_SDOT=0
    WASTE_I8MM=0
    WASTE_LOOKAHEAD=6
    WASTE_CUDA_KDA=1
    WASTE_CUDA_DENSE="$expected_dense"
    WASTE_CUDA_VQ=2
    WASTE_CUDA_VQ_GROUP=1
    WASTE_XPAR=0
)
for expected in "${expected_environment[@]}"; do
    if ! grep -Fxq "$expected" <<<"$live_environment"; then
        echo "WARP capability check failed: missing $expected" >&2
        exit 1
    fi
done

if ! sudo -n grep -q '/libcudart\.so' "/proc/$child_pid/maps"; then
    echo "WARP capability check failed: CUDA runtime is not loaded" >&2
    exit 1
fi

if [[ $profile == k3 ]]; then
    affinity=$(sudo -n awk '/^Cpus_allowed_list:/{print $2}' "/proc/$child_pid/status")
    if [[ $affinity != "$expected_affinity" ]]; then
        echo "WARP capability check failed: K3 CPU affinity is $affinity" >&2
        exit 1
    fi
    echo "CPU affinity check: PASS (external $affinity)"
else
    echo "CPU affinity check: PASS (compute-only $expected_affinity)"
fi
echo "Q0 capability check: PASS (child-scoped, latency_us=0)"
echo "CUDA capability check: PASS (dense and VQ3R modes match $profile profile)"
